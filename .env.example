# ==============================================================================
# Aarunodya Residency Bhakt Niwas - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Transactional Email (Booking confirmations & invoices)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Aarunodya Residency <reservations@yourdomain.com>"
EMAIL_DOMAIN="yourdomain.com"

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Staff Admin Session Security
ADMIN_SESSION_SECRET=your_admin_session_secret_min_32_characters_here
